vec3 bsdf(vec3 n,vec3 v,vec3 l,vec3 base,float rough,float metal,out float pdf){vec3 diffuse;return bsdfParts(n,v,l,base,rough,metal,pdf,diffuse);}
vec3 sampleBsdf(vec3 n,vec3 v,float rough,float metal){
    if(random()>mix(.35,.85,metal))return cosineDirection(n);
    float a=max(.025,rough*rough),u=random(),phi=2.0*PI*random();float ct=sqrt((1.0-u)/(1.0+(a*a-1.0)*u));
    vec3 h=localDirection(n,vec3(sqrt(max(0.0,1.0-ct*ct))*cos(phi),sqrt(max(0.0,1.0-ct*ct))*sin(phi),ct));return reflect(-v,h);
}
vec3 emission(int id){vec4 e=triangles[id*12+7];return linearColor(e.rgb)*e.a;}
int chooseEmitter(){float u=random();int lo=0,hi=emitterCount-1;while(lo<hi){int mid=(lo+hi)/2;if(u>emitters[mid].y)lo=mid+1;else hi=mid;}return int(emitters[lo].x);}
void integrate(vec3 o,vec3 d,int glassBranch,out vec3 diffuseRadiance,out vec3 specularRadiance){
