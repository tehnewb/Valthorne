        // detects disocclusion without rejecting sloping floors during navigation.
        float tolerance=max(.002,g.z*.002);
        if(abs(dot(oldPoint-p,normal))>tolerance||length(oldPoint-p)>max(.03,g.z*.03))continue;
        float w=(x==0?1.0-f.x:f.x)*(y==0?1.0-f.y:f.y);
        sum+=(specular?imageLoad(historySpecular,q):imageLoad(historyImage,q))*w;weights+=w;
    }
