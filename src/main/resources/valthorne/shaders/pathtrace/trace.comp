bool boxHit(vec3 o,vec3 inverseDirection,bvec3 parallel,vec3 lo,vec3 hi,float limit){
    if(any(bvec3(parallel.x&&(o.x<lo.x-1e-5||o.x>hi.x+1e-5),parallel.y&&(o.y<lo.y-1e-5||o.y>hi.y+1e-5),parallel.z&&(o.z<lo.z-1e-5||o.z>hi.z+1e-5))))return false;
