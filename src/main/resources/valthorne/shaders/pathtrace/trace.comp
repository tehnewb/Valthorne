}
void main(){
    ivec2 pixel=ivec2(gl_GlobalInvocationID.xy),size=imageSize(accumulation);if(any(greaterThanEqual(pixel,size)))return;
    vec3 point=vec3(0),normal=vec3(0);int centerId=-1;
    vec4 material=vec4(1);
    if(realtime!=0||sampleOffset==0){
        vec2 uv=(vec2(pixel)+pixelJitter)/vec2(size)*2.0-1.0;vec4 a=inverseCamera*vec4(uv,-1,1),b=inverseCamera*vec4(uv,1,1);a/=a.w;b/=b.w;
        vec3 origin=perspective!=0?cameraPosition:a.xyz,direction=normalize(b.xyz-origin);vec2 bary;float distance;
        if(trace(origin,direction,1e30,centerId,bary,distance)){
            normal=normalize(triangles[centerId*12+3].xyz*(1.0-bary.x-bary.y)+triangles[centerId*12+4].xyz*bary.x+triangles[centerId*12+5].xyz*bary.y);
            point=origin+direction*distance;imageStore(guide,pixel,vec4(octEncode(normal),distance,triangles[centerId*12+11].y+1.0));
            vec4 surface=triangles[centerId*12+8];material=vec4(max(baseColor(centerId,bary).rgb,vec3(.01)),surface.z>.5?-1.0:surface.x);
        }else imageStore(guide,pixel,vec4(0));
