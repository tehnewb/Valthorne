vec4 baseColor(int id,vec2 bary){int k=id*12;vec4 color=triangles[k+6];int layer=int(triangles[k+10].z);
    if(layer>=0){vec2 uv=triangles[k+9].xy*(1.0-bary.x-bary.y)+triangles[k+9].zw*bary.x+triangles[k+10].xy*bary.y;color*=textureLod(atlas,vec3(uv,layer),0.0);}
