    bool splitGlass=realtime!=0&&centerId>=0&&triangles[centerId*12+8].z>=.999;
    if(realtime!=0&&centerId>=0){vec4 surface=triangles[centerId*12+8];if(splitGlass)pathCount*=2;else if(surface.y>.5&&surface.x<.3)pathCount*=4;}
    vec3 diffuseSum=vec3(0),specularSum=vec3(0);
