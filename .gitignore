# Build tools and generated output (at any project depth)
.gradle/
.gradle-local/
build/
out/
bin/
target/
node_modules/
*.class
*.jar
*.war
*.ear
*.nar
!gradle/wrapper/gradle-wrapper.jar

# Local IDE state
.idea/
*.iml
*.ipr
*.iws
.classpath
.project
.settings/
.factorypath
.vscode/
.recommenders/
.loadpath

# Native extraction caches, recordings, and JVM diagnostics
.lwjgl/
lwjgl/
.filament-kmp/
# These are authored Java packages, not build output or extracted native libraries.
!/portable/web/src/main/java/valthorne/web/build/
!/portable/web/src/main/java/org/lwjgl/
*.log
hs_err_pid*
replay_pid*
*.hprof
*.jfr
core.*

# Local downloads, prototypes, and assistant scratch/reference checkouts
# Applications are maintained in the sibling examples and website repositories.
/website/
/src/examples/
/src/test/
/src/benchmark/
/integration-tests/
# Historical nested source snapshots must not reintroduce test folders.
**/src/test/
**/src/examples/
**/src/benchmark/
/assets/
/proto/
/private/
/.codex-temp/
/.codex_tmp*
/.claude/
/%TEMP%/
tmp/
temp/
__pycache__/
*.pyc
.venv/

# Credentials belong in the user Gradle home or environment, never in Git
.env
.env.*
!.env.example
*.local.properties
*.jks
*.keystore
*.p12
*.pfx
*.key
*.asc
/signing-data.png
/sonatype-token.png

# Downloaded distribution archives (runtime assets and provenance stay versioned)
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.rar

# Operating-system/editor metadata
.DS_Store
._*
.AppleDouble/
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*~
*.swp
*.swo

