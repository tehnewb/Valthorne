    }
}
// Reproject only matching surfaces. Bilinear taps are validated independently so
// foreground lighting cannot leak across a newly revealed silhouette.
vec2 octEncode(vec3 n){n/=abs(n.x)+abs(n.y)+abs(n.z);return n.z>=0.0?n.xy:(1.0-abs(n.yx))*mix(vec2(-1),vec2(1),greaterThanEqual(n.xy,vec2(0)));}
vec3 octDecode(vec2 p){vec3 n=vec3(p,1.0-abs(p.x)-abs(p.y));n.xy+=mix(vec2(1),vec2(-1),greaterThanEqual(n.xy,vec2(0)))*clamp(-n.z,0.0,1.0);return normalize(n);}
vec4 reproject(vec3 p,vec3 normal,float surfaceId,bool specular){
    if(historyValid==0)return vec4(0);
    vec4 clip=previousCamera*vec4(p,1);
    if(clip.w<=0.0)return vec4(0);
    vec3 ndc=clip.xyz/clip.w;
    if(any(greaterThan(abs(ndc),vec3(1))))return vec4(0);
    ivec2 size=imageSize(historyImage);
    vec2 location=(ndc.xy*.5+.5)*vec2(size)-previousJitter;
    // A stationary camera averages subpixel samples in the same output pixel.
    // Resampling that history every jitter step progressively blurs reflections.
    if(cameraMoving==0)location=vec2(gl_GlobalInvocationID.xy);
    ivec2 base=ivec2(floor(location));vec2 f=fract(location);
    vec4 sum=vec4(0);float weights=0.0;
    for(int y=0;y<2;y++)for(int x=0;x<2;x++){
        ivec2 q=base+ivec2(x,y);
        if(any(lessThan(q,ivec2(0)))||any(greaterThanEqual(q,size)))continue;
        vec4 g=imageLoad(historyGuide,q);
        if(g.z<=0.0||g.w!=surfaceId||dot(normal,octDecode(g.xy))<.95)continue;
        vec2 uv=(vec2(q)+previousJitter)/vec2(size)*2.0-1.0;
        vec4 a=previousInverse*vec4(uv,-1,1),b=previousInverse*vec4(uv,1,1);a/=a.w;b/=b.w;
        vec3 o=previousPerspective!=0?previousPosition:a.xyz;
