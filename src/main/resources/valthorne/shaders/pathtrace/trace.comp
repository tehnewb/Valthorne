                vec3 toLight=lp-p;float dist2=dot(toLight,toLight),dist=sqrt(dist2);vec3 l=toLight/max(dist,1e-8);
                vec3 ln=normalize(cross(triangles[lk+1].xyz,triangles[lk+2].xyz));float lightPdf=dist2*triangles[lk+11].x/max(abs(dot(ln,-l))*triangles[lk].w,1e-12);
                float pdf;vec3 fd;vec3 f=bsdfParts(n,v,l,base,surface.x,surface.y,pdf,fd);int blocker;vec2 q;float t;
                if(baseColor(light,vec2(u*(1.0-b),u*b)).a>=triangles[lk+10].w&&dot(geometric,l)>0.0&&!traceQuery(p+geometric*epsilon,l,max(0.0,dist-epsilon*2.0),true,blocker,q,t)){
