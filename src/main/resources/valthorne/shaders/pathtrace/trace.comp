            float fresnel=1.0;
            if(sinT2<1.0){float cosT=sqrt(1.0-sinT2);float rs=(eta*cosI-cosT)/(eta*cosI+cosT),rp=(cosI-eta*cosT)/(cosI+eta*cosT);fresnel=.5*(rs*rs+rp*rp);}
            bool reflection=random()<fresnel;
