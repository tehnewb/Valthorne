        int count=int(hi.w);if(count<0){int left=node+1,right=int(lo.w);bool reverse=d[-count-1]<0.0;stack[size++]=reverse?left:right;stack[size++]=reverse?right:left;continue;}
        for(int j=0;j<count;j++){int id=int(lo.w)+j,k=id*12;vec3 e1=triangles[k+1].xyz,e2=triangles[k+2].xyz;
