            integrate(o,d,splitGlass?branch:0,diffuse,specular);
            if(!any(isnan(diffuse))&&!any(isinf(diffuse)))diffuseSum+=diffuse/material.rgb;
            if(!any(isnan(specular))&&!any(isinf(specular)))specularSum+=specular;
        }
