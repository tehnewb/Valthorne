        if(!trace(o,d,1e30,id,bary,distance)){if(collect){diffuseRadiance+=throughput*diffuseWeight*sky;specularRadiance+=throughput*specularWeight*sky;}break;}
        int k=id*12;vec3 p=o+d*distance;vec3 geometric=normalize(cross(triangles[k+1].xyz,triangles[k+2].xyz));
        vec3 n=normalize(triangles[k+3].xyz*(1.0-bary.x-bary.y)+triangles[k+4].xyz*bary.x+triangles[k+5].xyz*bary.y);
        if(dot(n,geometric)<0.0)geometric=-geometric;bool front=dot(d,geometric)<0.0;if(!front){n=-n;geometric=-geometric;}
