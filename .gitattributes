# Auto detect text files and perform LF normalization
* text=auto
*.java text eol=lf
*.gradle text eol=lf
*.properties text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.sh text eol=lf
gradlew text eol=lf
*.bat text eol=crlf
*.jar binary
*.filamat binary
*.ktx binary
*.ttf binary
# Preserve upstream license texts and recorded benchmark output verbatim.
portable/web/public/licenses/** -text -whitespace
docs/benchmarks/**/*.json -whitespace
