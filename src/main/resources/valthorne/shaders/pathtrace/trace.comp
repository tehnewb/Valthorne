    }else{
        vec3 old=sampleOffset==0?vec3(0):imageLoad(accumulation,pixel).rgb;
        vec3 oldSpec=sampleOffset==0?vec3(0):imageLoad(specularImage,pixel).rgb;
        imageStore(accumulation,pixel,vec4((old*float(sampleOffset)+diffuseSum)/float(sampleOffset+pathCount),float(sampleOffset+pathCount)));
