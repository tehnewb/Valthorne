}
bool trace(vec3 o,vec3 d,float limit,out int hit,out vec2 bary,out float distance){return traceQuery(o,d,limit,false,hit,bary,distance);}
float powerWeight(float a,float b){return a*a/max(a*a+b*b,1e-20);}
float distribution(float nh,float a){float x=nh*nh*(a*a-1.0)+1.0;return a*a/(PI*x*x);}
float smith(float n,float a){return 2.0*n/max(n+sqrt(a*a+(1.0-a*a)*n*n),1e-8);}
vec3 bsdfParts(vec3 n,vec3 v,vec3 l,vec3 base,float rough,float metal,out float pdf,out vec3 diffuse){
    diffuse=vec3(0);
    float nv=max(dot(n,v),0.0),nl=max(dot(n,l),0.0);pdf=0.0;if(nv<=0.0||nl<=0.0)return vec3(0);
    vec3 h=normalize(v+l);float nh=max(dot(n,h),0.0),vh=max(dot(v,h),1e-6),a=max(.025,rough*rough);
