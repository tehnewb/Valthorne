#version 430 core
layout(local_size_x=8,local_size_y=8) in;
layout(rgba32f,binding=0) uniform image2D accumulation;
layout(rgba32f,binding=1) uniform writeonly image2D guide;
layout(rgba32f,binding=2) uniform image2D specularImage;
layout(rgba32f,binding=5) uniform readonly image2D historySpecular;
layout(rgba32f,binding=6) uniform image2D materialImage;
layout(std430,binding=0) readonly buffer Geometry { vec4 triangles[]; };
layout(std430,binding=1) readonly buffer Acceleration { vec4 nodes[]; };
layout(std430,binding=2) readonly buffer Emitters { vec2 emitters[]; };
uniform sampler2DArray atlas;
uniform mat4 inverseCamera;
uniform vec3 cameraPosition, sky;
uniform int perspective, triangleCount, emitterCount, sampleOffset, samplesPerFrame, maxBounces;
layout(rgba32f,binding=3) uniform readonly image2D historyImage;
layout(rgba32f,binding=4) uniform readonly image2D historyGuide;
uniform int realtime, historyValid, sequence, previousPerspective, cameraMoving, maxHistory;
uniform mat4 previousCamera, previousInverse;
uniform vec3 previousPosition;
uniform vec2 pixelJitter,previousJitter;
const float PI=3.14159265359;
uint rng;
float random(){rng=rng*747796405u+2891336453u;uint w=((rng>>((rng>>28u)+4u))^rng)*277803737u;return float((w>>22u)^w)/4294967296.;}
vec3 linearColor(vec3 c){return mix(c/12.92,pow((c+.055)/1.055,vec3(2.4)),step(vec3(.04045),c));}
vec3 localDirection(vec3 n,vec3 v){vec3 t=normalize(cross(abs(n.z)<.999?vec3(0,0,1):vec3(0,1,0),n));return t*v.x+cross(n,t)*v.y+n*v.z;}
