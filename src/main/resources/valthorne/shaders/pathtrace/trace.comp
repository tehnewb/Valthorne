        rng=uint(pixel.x+pixel.y*size.x)*9781u+uint((realtime!=0?sequence*32:sampleOffset)+sampleIndex+1)*6271u;
        vec2 uv=(vec2(pixel)+(realtime!=0?pixelJitter:vec2(random(),random())))/vec2(size)*2.0-1.0;
        vec4 a=inverseCamera*vec4(uv,-1,1),b=inverseCamera*vec4(uv,1,1);a/=a.w;b/=b.w;
        vec3 o=perspective!=0?cameraPosition:a.xyz,d=normalize(b.xyz-o),diffuse,specular;
